<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="IvanKondrashkov">
        <createTable tableName="notifications" schemaName="svc_notifications">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="message" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="notifications" schemaName="svc_notifications" indexName="idx_notifications_username">
            <column name="username"/>
        </createIndex>

        <createIndex tableName="notifications" schemaName="svc_notifications" indexName="idx_notifications_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="notifications" schemaName="svc_notifications" indexName="idx_notifications_type">
            <column name="type"/>
        </createIndex>

        <createIndex tableName="notifications" schemaName="svc_notifications" indexName="idx_notifications_created_at">
            <column name="created_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
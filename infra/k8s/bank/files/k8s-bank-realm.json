  "clients": [
    {
      "clientId": "bank-front-client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "bank-front-secret",
      "redirectUris": [
        "http://front.local/login/oauth2/code/*",
        "http://front.test.local/login/oauth2/code/*",
        "http://front.prod.local/login/oauth2/code/*"
      ],
      "baseUrl": "http://front.local",
      "webOrigins": [

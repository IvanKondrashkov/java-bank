    "realm": [
      {
        "name": "USER",
        "description": "Роль обычного пользователя"
      },
      {
        "name": "TRANSFER_WRITE",
        "description": "Разрешает пользователю выполнять переводы"
      },
      {
        "name": "CASH_WRITE",
        "description": "Разрешает пользователю выполнять операции с наличными"
      },
      {
        "name": "SERVICE",
        "description": "Роль для сервисных аккаунтов"
      },
      {
        "name": "ACCOUNTS_WRITE",
        "description": "Разрешает изменять балансы в accounts-service"
      },
      {
        "name": "ADMIN",
        "description": "Роль администратора"
      }
    ]
  },
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Nik",
      "lastName": "Poll",
      "email": "nik@bank.local",
      "credentials": [
        {
          "type": "password",
          "value": "admin-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN",
        "USER",
        "TRANSFER_WRITE",
        "CASH_WRITE"
      ]
    },
    {
      "username": "user",

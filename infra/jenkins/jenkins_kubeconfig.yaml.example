# Copy your local kubeconfig here and then adjust:
# 1) Set server to host.docker.internal so Jenkins container can access Minikube API.
# 2) Add insecure-skip-tls-verify: true for local cluster with self-signed certs.
#
# Example change:
# cluster:
#   server: https://host.docker.internal:8443
#   insecure-skip-tls-verify: true
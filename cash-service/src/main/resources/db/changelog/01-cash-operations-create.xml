<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="IvanKondrashkov">
        <createTable tableName="cash_operations" schemaName="svc_cash">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_number" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(1000)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="cash_operations" schemaName="svc_cash" indexName="idx_cash_operations_account_number">
            <column name="account_number"/>
        </createIndex>

        <createIndex tableName="cash_operations" schemaName="svc_cash" indexName="idx_cash_operations_created_at">
            <column name="created_at"/>
        </createIndex>

        <createIndex tableName="cash_operations" schemaName="svc_cash" indexName="idx_cash_operations_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="cash_operations" schemaName="svc_cash" indexName="idx_cash_operations_type">
            <column name="type"/>
        </createIndex>

        <createIndex tableName="cash_operations" schemaName="svc_cash" indexName="idx_cash_operations_account_status">
            <column name="account_number"/>
            <column name="status"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
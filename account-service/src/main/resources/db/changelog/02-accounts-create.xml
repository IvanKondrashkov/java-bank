<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="2" author="IvanKondrashkov">
        <createTable tableName="accounts" schemaName="svc_accounts">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_number" type="VARCHAR(20)">
                <constraints unique="true" nullable="false"/>
            </column>
            <column name="balance" type="DECIMAL(19,2)" defaultValue="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(3)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValue="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                constraintName="fk_accounts_user_id"
                baseTableSchemaName="svc_accounts"
                baseTableName="accounts"
                baseColumnNames="user_id"
                referencedTableSchemaName="svc_accounts"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"
                onUpdate="CASCADE"/>

        <createIndex indexName="idx_accounts_account_number" schemaName="svc_accounts" tableName="accounts">
            <column name="account_number"/>
        </createIndex>

        <createIndex indexName="idx_accounts_user_id" schemaName="svc_accounts" tableName="accounts">
            <column name="user_id"/>
        </createIndex>

        <createIndex indexName="idx_accounts_status" schemaName="svc_accounts" tableName="accounts">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_accounts_created_at" schemaName="svc_accounts" tableName="accounts">
            <column name="created_at"/>
        </createIndex>

        <createIndex indexName="idx_accounts_currency_status" schemaName="svc_accounts" tableName="accounts">
            <column name="currency"/>
            <column name="status"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>